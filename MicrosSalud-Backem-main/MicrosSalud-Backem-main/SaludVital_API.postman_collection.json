{
    "info": {
        "_postman_id": "saludvital-micros-collection",
        "name": "SaludVital – Microservicios",
        "description": "Colección completa de endpoints para el proyecto SaludVital. Todos los requests pasan por el API Gateway en http://localhost:8080.\n\n**Flujo recomendado de prueba:**\n1. Registrar un usuario (paciente o médico)\n2. Hacer login y copiar el token JWT\n3. Pegar el token en la variable `{{token}}` del entorno\n4. Usar el resto de endpoints con el header Authorization: Bearer {{token}}",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:8080",
            "type": "string",
            "description": "URL base del API Gateway"
        },
        {
            "key": "token",
            "value": "",
            "type": "string",
            "description": "JWT obtenido tras hacer login. Se puede auto-rellenar usando el script del request Login."
        }
    ],
    "item": [
        {
            "name": "🔐 Auth Service",
            "description": "Autenticación y registro de usuarios. Base path: /api/auth",
            "item": [
                {
                    "name": "Registrar Paciente",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/auth/register",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "register"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"username\": \"juan.perez\",\n  \"email\": \"juan.perez@example.com\",\n  \"password\": \"password123\",\n  \"role\": [\"paciente\"],\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Pérez\",\n  \"numeroIdentificacion\": \"1234567890\",\n  \"fechaNacimiento\": \"1990-05-15\",\n  \"telefono\": \"3001234567\",\n  \"direccion\": \"Calle 123 # 45-67, Bogotá\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Registrar Médico",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/auth/register",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "register"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"username\": \"dra.garcia\",\n  \"email\": \"garcia@saludvital.com\",\n  \"password\": \"medico123\",\n  \"role\": [\"medico\"],\n  \"nombre\": \"María\",\n  \"apellido\": \"García\",\n  \"numeroIdentificacion\": \"9876543210\",\n  \"telefono\": \"3109876543\",\n  \"direccion\": \"Av. Salud # 10-20, Medellín\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "var jsonData = pm.response.json();",
                                    "if (jsonData.token) {",
                                    "    pm.collectionVariables.set('token', jsonData.token);",
                                    "    console.log('Token JWT guardado automáticamente en la variable {{token}}');",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/auth/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "login"
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"username\": \"juan.perez\",\n  \"password\": \"password123\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Refresh Token",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Authorization",
                                "value": "Bearer {{token}}"
                            }
                        ],
                        "url": {
                            "raw": "{{base_url}}/api/auth/refresh",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "auth",
                                "refresh"
                            ]
                        }
                    }
                }
            ]
        },
